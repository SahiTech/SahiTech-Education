# ==============================================================================
# SahiTech Education — Madrasa Digitalization Initiative (MDI)
# Production & Vercel Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE CONFIGURATION (MANDATORY FOR VERCEL DEPLOYMENT)
# ------------------------------------------------------------------------------
# [PUBLIC] The unique HTTPS endpoint of your Supabase project.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [PUBLIC] The public anonymous API key (JWT).
# Safe to expose to the browser; all table access is strictly gated by PostgreSQL RLS.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt-key

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION & LOCALIZATION (OPTIONAL / DEFAULTS PROVIDED)
# ------------------------------------------------------------------------------
# [PUBLIC] Institutional branding and system title
NEXT_PUBLIC_APP_NAME="SahiTech Education MDI"

# [PUBLIC] Primary interface language (bn = Bangla, en = English, ar = Arabic)
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# [PUBLIC] Default academic engine (qawmi = Dars-e-Nizami, alia = BMEB Board)
NEXT_PUBLIC_DEFAULT_CURRICULUM=qawmi

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER / NOT REQUIRED FOR VERCEL WEB)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Supabase Service Role Key.
# WARNING: Bypasses Row Level Security (RLS). 
# NOT required for standard Vercel Next.js runtime (the app uses user session cookies).
# Keep empty unless executing out-of-band administrative migration scripts.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# [SERVER-ONLY] Optional SMS gateway credentials for future notification provider
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# [SERVER-ONLY] Optional Payment gateway credentials for future bKash direct merchant checkout
PAYMENT_GATEWAY_PROVIDER=mock
BKASH_APP_KEY=
BKASH_APP_SECRET=

# ------------------------------------------------------------------------------
# 4. MDI PUBLIC APPLICATION & RESEND OUTBOX WORKER (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Canonical HTTPS origin of the web deployment (not a secret).
NEXT_PUBLIC_SITE_URL=https://your-deployment-domain.example

# Shared high-entropy secret used by Next.js server actions and the Supabase Edge Function.
# Generate at least 32 random bytes (e.g. openssl rand -hex 32); use the EXACT same value in both environments.
# It derives bearer tokens from random nonces. Raw invitation/upload tokens are never stored in DB.
MDI_EMAIL_TOKEN_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Supabase Edge Function process-email-outbox secrets (configure with Supabase secrets).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=replace-with-a-long-random-secret
PUBLIC_SITE_URL=https://your-deployment-domain.example
RESEND_API_KEY=
RESEND_FROM_EMAIL="SahiTech Education <no-reply@your-verified-sending-domain>"
